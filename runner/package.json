{
  "name": "fava-runner",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test src/*.test.mjs",
    "build:dry": "wrangler deploy --dry-run --outdir /tmp/fava-runner-build",
    "dev": "wrangler dev",
    "deploy": "node ./verify-config.mjs && wrangler deploy"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/node": "^20",
    "typescript": "^5.9.0",
    "wrangler": "4.149.0"
  }
}
